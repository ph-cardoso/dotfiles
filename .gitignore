# Machine-specific git identity / commit signing (created from
# .gitconfig.local.example by install.sh)
.gitconfig.local

# Bootstrapped by install.sh, not vendored
.zsh/plugins/*
!.zsh/plugins/.gitkeep
bin/win32yank.exe

# Legacy tmux plugin manager dir (tmux is now plugin-free)
tmux/plugins

# Machine overrides and non-destructive installer backups
profile.local.ps1
*.bak.*

# Fish keeps per-machine state and overrides outside version control.
.config/fish/fish_variables
.config/fish/config.local.fish
.config/fish/fish_plugins
*_history
